# Copy to backend/.env for local development. Never commit the real .env.
# In production (Render), set these in the service's Environment tab instead.

# "production" turns on strict config validation, trust-proxy and disables
# code execution by default. Leave unset locally.
NODE_ENV=

# Port/host to listen on. Render injects PORT automatically; do not set it there.
PORT=5001
# HOST=0.0.0.0                   # default: 0.0.0.0 in production, all interfaces locally

# Redis connection. Local: redis://localhost:6379
# Upstash: use the "rediss://" (TLS) URL from the Upstash console.
REDIS_URL=redis://localhost:6379

# Allowed frontend origin(s), comma-separated, no trailing slash.
# Required in production, e.g. https://blip-yourname.vercel.app
FRONTEND_URL=http://localhost:3000

# Enables /admin when set (use 12+ random characters). Leave empty to disable admin.
ADMIN_PASSWORD=

# Untrusted code execution (/api/run). Defaults: on in development, OFF in production.
# Python/Java/C++ run without a sandbox — only enable on an isolated host.
CODE_EXECUTION=

# Optional tuning
# HOST_GRACE_MS=45000            # how long a room waits for a disconnected host
# ROOM_CREATE_LIMIT_PER_MIN=20   # room creations per IP per minute
# ROOM_ATTACHMENT_BUDGET_MB=20   # attachment storage per room
# CODE_FLUSH_MS=2000             # max delay before editor content is written to Redis
# TRUST_PROXY=1                  # proxy hops in front of the app (default 1 in production)
